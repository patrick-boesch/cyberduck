target
.idea/*
!.idea/codeStyleSettings.xml
!.idea/copyright
*.iml
xcuserdata/

# VSCode/Java #
###############
.classpath
.project
.settings
.factorypath

# Compiled source #
###################
*.com
*.class
*.o
*.so

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# .NET stuff #
##############
.vs/
*.suo
*.user
*.sdf
*.opensdf
*.DotSettings.user
obj/

packages/

# Repository-local macOS build caches and Xcode DerivedData
/.build/

# Xcode output at the project root and in platform/native modules.
# Keep source build definitions below src/ visible to Git.
/build/
/Build/
/*/build/
/*/Build/
/*/*/build/
/*/*/Build/
DerivedData/
ModuleCache.noindex/
Index.noindex/
*.app/
*.dSYM/
*.xcarchive/
*.xcresult/
*.xcactivitylog
*.xcuserstate
